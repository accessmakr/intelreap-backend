{
  "name": "intelreap-backend",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "alias": {
    "node-fetch": "./src/shims/node-fetch.js",
    "maxmind": "./src/shims/empty.js",
    "@upstash/redis": "./src/shims/empty.js"
  },
  "build": {
    "command": "node scripts/fetch-geo-data.js && node scripts/build-geo-shards.js"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
